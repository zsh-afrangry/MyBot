{
  "version": 1,
  "name": "kurumi-stack",
  "description": "统一管理本机 DSH / Fusion(OpenClaw) / 管理台 / SnowLuma+QQ / KnowledgeMap 的清单。启动顺序按 order 升序，停止按降序。",
  "bootPolicy": "auto",
  "defaultStop": ["admin-web", "fusion", "dsh"],
  "components": [
    {
      "id": "mysql",
      "label": "MySQL（外部依赖）",
      "kind": "system",
      "unit": "mysql.service",
      "order": 10,
      "ports": [3306],
      "probes": [{"type": "tcp", "port": 3306}],
      "external": true,
      "boot": {"enabled": true, "managed": false},
      "log": {"scope": "system", "unit": "mysql.service"},
      "startTimeoutSec": 20
    },
    {
      "id": "mongodb",
      "label": "KnowledgeMap MongoDB",
      "kind": "user",
      "unit": "knowledgemap-mongodb.service",
      "order": 20,
      "ports": [27017],
      "probes": [{"type": "tcp", "port": 27017}],
      "dependsOn": ["mysql"],
      "boot": {"enabled": true, "managed": true},
      "log": {"scope": "user", "unit": "knowledgemap-mongodb.service"},
      "startTimeoutSec": 20,
      "graceSec": 5
    },
    {
      "id": "km-api",
      "label": "KnowledgeMap 助手 API",
      "kind": "user",
      "unit": "knowledgemap-assistant.service",
      "order": 30,
      "ports": [3086],
      "probes": [{"type": "http", "url": "http://127.0.0.1:3086/api/assistant/status", "expect": [401, 403]}],
      "dependsOn": ["mysql"],
      "boot": {"enabled": true, "managed": true},
      "log": {"scope": "user", "unit": "knowledgemap-assistant.service"},
      "startTimeoutSec": 30,
      "graceSec": 8
    },
    {
      "id": "km-web",
      "label": "KnowledgeMap 网站（8020 / Tailscale 8443）",
      "kind": "user",
      "unit": "knowledgemap-web.service",
      "order": 40,
      "ports": [8020],
      "probes": [{"type": "http", "url": "http://127.0.0.1:8020/", "expect": [200, 401]}],
      "dependsOn": ["mongodb", "mysql"],
      "boot": {"enabled": true, "managed": true},
      "log": {"scope": "user", "unit": "knowledgemap-web.service"},
      "launcher": {
        "root": "/home/afrangry/repository",
        "start": "/home/afrangry/repository/Start-KnowledgeMap.sh",
        "stop": "/home/afrangry/repository/Stop-KnowledgeMap.sh",
        "stateFile": "/home/afrangry/.local/state/knowledgemap-launcher/web.json",
        "unitFile": "/home/afrangry/.config/systemd/user/knowledgemap-web.service"
      },
      "startTimeoutSec": 180,
      "graceSec": 20
    },
    {
      "id": "dsh",
      "label": "DeepSeek Harness Web",
      "kind": "system",
      "unit": "dsh-web.service",
      "order": 50,
      "ports": [3080],
      "probes": [{"type": "http", "url": "http://127.0.0.1:3080/", "expect": [401, 404]}],
      "sudo": true,
      "boot": {"enabled": true, "managed": true},
      "log": {"scope": "system", "unit": "dsh-web.service"},
      "startTimeoutSec": 45,
      "graceSec": 15
    },
    {
      "id": "snowluma",
      "label": "SnowLuma（3082 WebUI / 3083 OneBot HTTP / 3084 OneBot WS）",
      "kind": "user",
      "unit": "snowluma.service",
      "order": 60,
      "ports": [3082, 3083, 3084],
      "probes": [
        {"type": "http", "url": "http://127.0.0.1:3082/", "expect": [200, 401]},
        {"type": "http", "url": "http://127.0.0.1:3083/", "expect": [401, 403, 404]},
        {"type": "tcp", "port": 3084}
      ],
      "needsDisplay": true,
      "boot": {"enabled": true, "managed": true},
      "log": {"scope": "user", "unit": "snowluma.service"},
      "logDir": "/home/afrangry/snowluma/runtime/logs/",
      "startTimeoutSec": 90,
      "graceSec": 30
    },
    {
      "id": "qq",
      "label": "QQ 客户端（SnowLuma hook）",
      "kind": "user",
      "unit": "snowluma-qq.service",
      "order": 70,
      "ports": [],
      "probes": [],
      "needsDisplay": true,
      "dependsOn": ["snowluma"],
      "semantic": "qq",
      "boot": {"enabled": true, "managed": true},
      "log": {"scope": "user", "unit": "snowluma-qq.service"},
      "startTimeoutSec": 90,
      "graceSec": 30
    },
    {
      "id": "fusion",
      "label": "Kurumi Fusion Gateway（OpenClaw）",
      "kind": "user",
      "unit": "kurumi-fusion.service",
      "order": 80,
      "ports": [18890],
      "probes": [{"type": "http", "url": "http://127.0.0.1:18890/", "expect": [200, 401, 404]}],
      "dependsOn": ["km-api", "snowluma", "qq"],
      "boot": {"enabled": true, "managed": true},
      "log": {"scope": "user", "unit": "kurumi-fusion.service"},
      "logFile": "/home/afrangry/.openclaw-fusion/runtime.log",
      "startTimeoutSec": 60,
      "graceSec": 20
    },
    {
      "id": "admin-web",
      "label": "Fusion 管理台（3085）",
      "kind": "user",
      "unit": "kurumi-admin-web.service",
      "order": 90,
      "ports": [3085],
      "probes": [{"type": "http", "url": "http://127.0.0.1:3085/", "expect": [200, 401]}],
      "dependsOn": ["fusion"],
      "boot": {"enabled": true, "managed": true},
      "log": {"scope": "user", "unit": "kurumi-admin-web.service"},
      "startTimeoutSec": 30,
      "graceSec": 10
    }
  ]
}
