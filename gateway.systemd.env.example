# OpenClaw Gateway systemd environment template.
# Copy this file to /home/afrangry/.openclaw/gateway.systemd.env, replace every
# placeholder, then set the real file mode to 600. Never commit or paste the
# real file into chat, docs, or the repository.

# Gateway and QQ Bot
OPENCLAW_GATEWAY_TOKEN=replace-with-a-random-gateway-token
QQBOT_APP_ID=replace-with-qq-app-id
QQBOT_APP_SECRET=replace-with-qq-app-secret

# Current Terra primary/fallback provider
OPENAI_BASE_URL=https://naiccc.com/v1
OPENAI_API_KEY=replace-with-naiccc-api-key

# Controlled DeepSeek search provider
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-deepseek-api-key

# Personal weather provider
QWEATHER_API_HOST=replace-with-qweather-dedicated-host
QWEATHER_API_KEY=replace-with-qweather-api-key

# Current Qwen Token Plan primary provider
# `bailian-token-plan` in openclaw.json reads only this Key through a
# SecretRef. Its stable endpoint is fixed in that config to the official
# Anthropic-compatible /apps/anthropic URL.
QWEN_TOKEN_PLAN_API_KEY=replace-with-qwen-token-plan-api-key

# The following OpenAI-compatible endpoint is intentionally NOT read by the
# current stable model config. Keep it only as a documented future candidate;
# do not assume setting it switches the running provider.
# QWEN_TOKEN_PLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Optional future Qwen credential: no current Kurumi component reads either
# variable. Do not enable it unless a separately tested provider/tool uses it.
# QWEN_API_HOST=https://llm-ri9o9evlvsrv943u.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=replace-with-qwen-api-key
