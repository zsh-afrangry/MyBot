# OpenClaw global runtime environment template.
# Copy this file to ~/.openclaw/.env. Do not commit real credentials.

# The installed gateway creates this token automatically. Keep its real value
# private; this template deliberately contains only a placeholder.
OPENCLAW_GATEWAY_TOKEN=xxxx

# QQ Open Platform credentials (replace both values before enabling qqbot).
QQBOT_APP_ID=xxxx
QQBOT_APP_SECRET=xxxx

# Choose one supported model provider and replace its key.
OPENAI_API_KEY=xxxx

# Reserved for the later weather tool implementation.
WEATHER_API_KEY=xxxx
WEATHER_API_BASE_URL=xxxx
