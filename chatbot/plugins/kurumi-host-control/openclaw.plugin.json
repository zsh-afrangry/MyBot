{
  "id": "kurumi-host-control",
  "name": "Kurumi host controls",
  "version": "0.1.0",
  "description": "Trusted access policy, owner exec confinement and optional autonomous action",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "proactive": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled",
          "revision",
          "intervalMs",
          "timeoutMs",
          "notifyEnabled",
          "reads",
          "publicSearch",
          "night"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "intervalMs": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 86400000
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000
          },
          "notifyEnabled": {
            "type": "boolean"
          },
          "reads": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "weather",
                "planning",
                "reminders",
                "reminder_list"
              ]
            }
          },
          "publicSearch": {
            "type": "boolean"
          },
          "night": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startMinute",
              "endMinute",
              "timeZone",
              "activityMaxAgeMs"
            ],
            "properties": {
              "startMinute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1439
              },
              "endMinute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1439
              },
              "timeZone": {
                "type": "string"
              },
              "activityMaxAgeMs": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "exec": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "writeBoundary",
          "workdir",
          "timeoutSeconds"
        ],
        "properties": {
          "writeBoundary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "launcher"
            ],
            "properties": {
              "root": {
                "type": "string",
                "minLength": 2
              },
              "additionalRoots": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              },
              "launcher": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "workdir": {
            "type": "string",
            "minLength": 1
          },
          "timeoutSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 300
          }
        }
      }
    },
    "additionalProperties": false
  },
  "contracts": {
    "tools": [
      "kurumi_proactive"
    ]
  },
  "toolMetadata": {
    "kurumi_proactive": {
      "optional": true
    }
  }
}
