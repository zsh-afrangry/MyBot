{
  "id": "personal-profile",
  "name": "personal-profile",
  "description": "Independent profile capability",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiHost": {
        "type": "string",
        "description": "QWeather dedicated API hostname without scheme or path."
      },
      "apiKey": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "source",
              "provider",
              "id"
            ],
            "properties": {
              "source": {
                "type": "string",
                "const": "env"
              },
              "provider": {
                "type": "string",
                "const": "default"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "weatherBackend": {
        "type": "string",
        "enum": [
          "qweather",
          "knowledgemap"
        ]
      },
      "shareDefaultCity": {
        "type": "boolean",
        "description": "Expose the confirmed owner location to the authenticated KnowledgeMap website."
      },
      "bridgeBaseUrl": {
        "type": "string"
      },
      "bridgeTokenFile": {
        "type": "string",
        "pattern": "^/"
      },
      "locationCatalog": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "name",
            "countryCode",
            "latitude",
            "longitude",
            "timezone",
            "precision"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "countryCode": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "adm1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "adm2": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "precision": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "city"
                },
                {
                  "type": "string",
                  "const": "district"
                },
                {
                  "type": "string",
                  "const": "point"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 512
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "personal_profile_state_get",
      "personal_profile_change_propose",
      "personal_profile_change_commit"
    ]
  },
  "toolMetadata": {
    "personal_profile_state_get": {
      "optional": true
    },
    "personal_profile_change_propose": {
      "optional": true
    },
    "personal_profile_change_commit": {
      "optional": true
    }
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "apiKey",
          "expected": "string"
        }
      ]
    }
  },
  "uiHints": {
    "apiHost": {
      "label": "QWeather API host"
    },
    "apiKey": {
      "label": "QWeather credential",
      "sensitive": true
    }
  }
}
