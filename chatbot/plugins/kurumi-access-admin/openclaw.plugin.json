{
  "id": "kurumi-access-admin",
  "name": "Kurumi allowlist administration",
  "description": "Owner-confirmed changes to specifically enabled allowlists in the repository.",
  "version": "0.1.0",
  "activation": {"onStartup": true},
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sourceRoot"],
    "properties": {
      "sourceRoot": {"type": "string", "minLength": 2},
      "feedbackActions": {
        "type": "array", "uniqueItems": true,
        "items": {"type": "string", "enum": ["access.member", "access.mail_recipient", "access.mail_sender", "access.owner_tool", "access.exec_root", "access.coding_project"]}
      },
      "enabledCategories": {
        "type": "array", "uniqueItems": true,
        "items": {"type": "string", "enum": ["mail_recipient", "mail_sender", "owner_tool", "exec_root", "coding_project"]}
      },
      "execDirectoryBases": {
        "type": "array", "maxItems": 16, "uniqueItems": true,
        "items": {"type": "string", "minLength": 2, "maxLength": 4096}
      },
      "projectCheckProfiles": {
        "type": "object",
        "maxProperties": 16,
        "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,39}$"},
        "additionalProperties": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "argv"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-zA-Z0-9_ .-]{1,100}$"},
              "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "timeoutMs": {"type": "integer", "minimum": 1},
              "skipExitCode": {"type": "integer", "minimum": 1, "maximum": 255}
            }
          }
        }
      }
    }
  },
  "contracts": {
    "tools": ["kurumi_access"]
  },
  "toolMetadata": {
    "kurumi_access": {"optional": true}
  }
}
