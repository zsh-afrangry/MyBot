{
  "id": "kurumi-access-admin",
  "name": "Kurumi allowlist administration",
  "description": "Owner-confirmed changes to specifically enabled allowlists in the repository.",
  "version": "0.1.0",
  "activation": {"onStartup": true},
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sourceRoot"],
    "properties": {
      "sourceRoot": {"type": "string", "minLength": 2},
      "enabledCategories": {
        "type": "array", "uniqueItems": true,
        "items": {"type": "string", "enum": ["mail_recipient", "owner_tool", "exec_root"]}
      },
      "execDirectoryBases": {
        "type": "array", "maxItems": 16, "uniqueItems": true,
        "items": {"type": "string", "minLength": 2, "maxLength": 4096}
      }
    }
  },
  "contracts": {
    "tools": ["kurumi_access"]
  },
  "toolMetadata": {
    "kurumi_access": {"optional": true}
  }
}
