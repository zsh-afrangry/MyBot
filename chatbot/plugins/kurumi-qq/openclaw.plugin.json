{
  "id": "kurumi-qq",
  "channels": [
    "kurumi-qq"
  ],
  "name": "Kurumi QQ",
  "description": "Isolated identity-scoped OneBot channel",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "exec": {
        "type": "object",
        "additionalProperties": false,
        "required": ["writeBoundary", "workdir", "timeoutSeconds"],
        "properties": {
          "writeBoundary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "launcher"],
            "properties": {
              "root": {"type": "string", "minLength": 2},
              "additionalRoots": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
              "launcher": {"type": "string", "minLength": 1}
            }
          },
          "workdir": {"type": "string", "minLength": 1},
          "timeoutSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300}
        }
      }
    },
    "additionalProperties": false
  },
  "channelConfigs": {
    "kurumi-qq": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "ownerId": {
            "type": "string"
          },
          "httpUrl": {
            "type": "string"
          },
          "wsUrl": {
            "type": "string"
          },
          "httpTokenFile": {
            "type": "string"
          },
          "wsTokenFile": {
            "type": "string"
          },
          "stateDir": {
            "type": "string"
          },
          "mediaRoot": {
            "type": "string"
          },
          "sendLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "chunkLimit": {
            "type": "integer",
            "minimum": 100,
            "maximum": 4000
          },
          "replyToMode": {
            "type": "string",
            "enum": ["off", "first", "all"],
            "default": "off"
          },
          "testIngress": {
            "type": "boolean"
          },
          "dailySendLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "naturalSegments": {
            "type": "boolean"
          },
          "segmentDelayMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "accessControl": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "kurumi_test_wait",
      "kurumi_sticker"
    ],
    "trustedToolPolicies": [
      "kurumi-access-control"
    ]
  },
  "toolMetadata": {
    "kurumi_test_wait": {
      "optional": true
    },
    "kurumi_sticker": {
      "optional": true
    }
  }
}
