{
  "id":"kurumi-knowledgemap","name":"KnowledgeMap bills","version":"0.2.0",
  "description":"Owner-only shared bills: create, query, single-record update and delete",
  "activation":{"onStartup":true},
  "configSchema":{
    "type":"object","additionalProperties":false,"required":["tokenFile"],
    "properties":{
      "baseUrl":{"type":"string"},
      "tokenFile":{"type":"string","pattern":"^/"},
      "feedbackActions":{"type":"array","uniqueItems":true,"items":{"type":"string","enum":["bill.create","bill.update","bill.delete","bill.import"]}}
    }
  },
  "contracts":{"tools":["knowledge_bills_get","knowledge_bill_add","knowledge_bill_manage","knowledge_bill_import"]},
  "toolMetadata":{"knowledge_bills_get":{"optional":true},"knowledge_bill_add":{"optional":true},"knowledge_bill_manage":{"optional":true},"knowledge_bill_import":{"optional":true}}
}
