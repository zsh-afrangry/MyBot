{
  "id": "kurumi-logs",
  "name": "Read-only diagnostics",
  "version": "0.1.0",
  "description": "Owner-private bounded technical-only log queries; no raw content, arbitrary files or repair execution",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "kurumi_logs"
    ]
  },
  "toolMetadata": {
    "kurumi_logs": {
      "optional": true,
      "replaySafe": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "runtimeRoot",
      "snowlumaRoot"
    ],
    "properties": {
      "runtimeRoot": {
        "type": "string",
        "pattern": "^/"
      },
      "snowlumaRoot": {
        "type": "string",
        "pattern": "^/"
      }
    }
  }
}
