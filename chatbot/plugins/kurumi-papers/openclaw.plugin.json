{
  "id": "kurumi-papers",
  "name": "Kurumi paper translation",
  "configSchema": {
    "type": "object", "additionalProperties": false,
    "required": ["root", "python", "credentialsFile"],
    "properties": {
      "root": {"type": "string"},
      "python": {"type": "string"},
      "credentialsFile": {"type": "string"},
      "liveTranslationEnabled": {"type": "boolean", "default": false},
      "maxPages": {"type": "integer", "minimum": 1, "maximum": 500, "default": 30},
      "maxRequests": {"type": "integer", "minimum": 1, "maximum": 2000, "default": 300},
      "maxReportedTokens": {"type": "integer", "minimum": 100, "maximum": 2000000, "default": 150000},
      "apiConcurrency": {"type": "integer", "minimum": 1, "maximum": 4, "default": 1},
      "apiQps": {"type": "integer", "minimum": 1, "maximum": 4, "default": 1},
      "batchValidationRetries": {"type": "integer", "minimum": 0, "maximum": 4, "default": 1},
      "channelRecoveryRetries": {"type": "integer", "minimum": 0, "maximum": 4, "default": 1},
      "timeoutSeconds": {"type": "integer", "minimum": 30, "maximum": 1800, "default": 1800}
    }
  },
  "activation": {"onStartup": true},
  "contracts": {"tools": ["kurumi_document", "kurumi_translate", "kurumi_document_send"]},
  "toolMetadata": {"kurumi_document": {"optional": true}, "kurumi_translate": {"optional": true}, "kurumi_document_send": {"optional": true}}
}
