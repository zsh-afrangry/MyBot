{
  "id": "kurumi-e7",
  "name": "E7 public wiki data",
  "version": "0.1.0",
  "description": "Owner-only bounded read queries for E7·WIKI; no image sending or arbitrary fetch",
  "activation": {"onStartup": true},
  "contracts": {"tools": ["e7_data"]},
  "toolMetadata": {"e7_data": {"optional": true, "replaySafe": true}},
  "configSchema": {
    "type": "object", "additionalProperties": false, "required": ["cacheRoot"],
    "properties": {
      "cacheRoot": {"type": "string", "pattern": "^/"},
      "refreshEnabled": {"type": "boolean"},
      "refreshTime": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
      "detailTtlHours": {"type": "integer", "minimum": 1, "maximum": 168},
      "liveTtlMinutes": {"type": "integer", "minimum": 1, "maximum": 60},
      "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 30000},
      "maxResponseBytes": {"type": "integer", "minimum": 1024, "maximum": 4194304}
    }
  }
}
